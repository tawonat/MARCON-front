# db:migrate cria o banco se não existir (requer permissão CREATE).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=marcon
DB_USER=root
DB_PASSWORD=root
# Alternativa: DATABASE_URL=mysql://usuario:senha@127.0.0.1:3306/marcon
# DB_NAME e DB_USER têm prioridade sobre DATABASE_URL.
SESSION_SECRET=troque_por_um_segredo_aleatorio_longo_e_privado
# Também protege os embeddings faciais locais. Trocar o segredo exige recadastro facial.
# Defina apenas ao executar npm run db:seed; remova após o seed.
SEED_PASSWORD=Marcon@12345
